# ─────────────────────────────────────────────────────────────
# NOVASTORE — variables de entorno
# Copia este archivo como `.env` y rellena los valores.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# URL pública de la tienda (sin barra final). En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Base de datos PostgreSQL
# Local con docker compose: postgresql://novastore:novastore@localhost:5432/novastore
# Neon/Supabase: DATABASE_URL = conexión "pooled", DIRECT_URL = conexión directa
DATABASE_URL="postgresql://novastore:novastore@localhost:5432/novastore?schema=public"
DIRECT_URL="postgresql://novastore:novastore@localhost:5432/novastore?schema=public"

# Stripe — usa claves de PRUEBA (sk_test_ / pk_test_) durante el desarrollo
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Secreto de firma del webhook (whsec_...). En local lo da `stripe listen`.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Sesión del panel de administración: cadena aleatoria de 32+ caracteres
# Genera una con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-una-cadena-aleatoria-muy-larga"

# Administrador inicial (se crea con `npm run db:seed` o `npm run admin:create`)
ADMIN_EMAIL="admin@novastore.example"
ADMIN_PASSWORD="cambia-esta-contraseña"

# Almacenamiento de imágenes
# - Sin BLOB_READ_WRITE_TOKEN: se guardan en disco (carpeta UPLOAD_DIR). Válido en VPS/Railway/Render con disco persistente.
# - Con BLOB_READ_WRITE_TOKEN: se guardan en Vercel Blob (obligatorio si despliegas en Vercel).
UPLOAD_DIR="./uploads"
BLOB_READ_WRITE_TOKEN=""

# Datos de contacto y redes sociales (se muestran en cabecera/footer)
NEXT_PUBLIC_STORE_EMAIL="hola@novastore.example"
NEXT_PUBLIC_STORE_PHONE=""
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/"
NEXT_PUBLIC_TIKTOK_URL="https://www.tiktok.com/"
# Razón social / titular y dirección para el aviso legal
NEXT_PUBLIC_LEGAL_NAME="[Nombre o razón social]"
NEXT_PUBLIC_LEGAL_ID="[NIF/CIF]"
NEXT_PUBLIC_LEGAL_ADDRESS="[Dirección fiscal]"

# Productos de demostración: solo se pueden "comprar" con claves de prueba de Stripe.
# Con claves live (sk_live_) siempre se bloquean, sea cual sea este valor.
ALLOW_DEMO_CHECKOUT="true"

# Integraciones de transportistas (futuro). Si están vacías, la generación de etiquetas queda desactivada.
CORREOS_API_USER=""
CORREOS_API_PASSWORD=""
CORREOS_CONTRACT_CODE=""
GLS_API_UID=""
GLS_API_URL=""
DHL_API_KEY=""
DHL_API_SECRET=""
DHL_ACCOUNT_NUMBER=""

# Solo desarrollo/tests: apunta el SDK de Stripe a stripe-mock (http://localhost:12111). Déjalo vacío en producción.
STRIPE_API_HOST_OVERRIDE=""

# Protege el endpoint /api/cron/expire-orders (libera stock de pedidos abandonados). Cadena aleatoria.
CRON_SECRET=""
